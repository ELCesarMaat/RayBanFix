<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RayBanFix" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/rb_background</item>
        <item name="android:windowLightStatusBar">@bool/rb_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/rb_light_system_bars</item>
        <item name="android:colorAccent">@color/rb_primary</item>
        <item name="android:colorControlActivated">@color/rb_primary</item>
        <item name="android:textColorPrimary">@color/rb_on_surface</item>
        <item name="android:textColorSecondary">@color/rb_on_surface_variant</item>
    </style>

    <style name="Theme.RayBanFix.Translucent" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="RbTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/rb_on_surface</item>
    </style>

    <style name="RbCardTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/rb_on_surface</item>
    </style>

    <style name="RbBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/rb_on_surface_variant</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="RbIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/rb_on_surface_variant</item>
    </style>

    <style name="RbButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <style name="RbButton.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/rb_on_primary</item>
        <item name="android:drawableTint">@color/rb_on_primary</item>
    </style>

    <style name="RbButton.Tonal">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textColor">@color/rb_on_primary_container</item>
        <item name="android:drawableTint">@color/rb_on_primary_container</item>
    </style>
</resources>
